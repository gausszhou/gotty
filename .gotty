{
  "address": "",
  "port": "8080",
  "permit_write": false,
  "credential": "",
  "title_format": "GoTTY - {{ .command }}@{{ .hostname }}",
  "enable_reconnect": false,
  "reconnect_time": 10,
  "max_session": 0,
  "timeout": 0,
